.nixpacks/
nixpacks.*
.nixpacks.toml.lock

# Environment files
.env
.env.local
.env.*.local

# Logs
logs/
*.log
*.out
*.err

# PM2 logs
pids/
*.pid
*.seed
*.pid.lock

# Railway deployment artifacts
.cache/
.build/
dist/

