Z_Inventarios/*.xls
Z_Inventarios/*.csv
Z_Inventarios/**/*.xlsx
Z_Inventarios/**/*.xls
Z_Inventarios/**/*.csv

# Caso queira subir apenas a estrutura vazia:
!Z_Inventarios/
!Z_Inventarios/.keep   # use um arquivo vazio se quiser manter a pasta

